{
  "name": "airport-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "contracts:export": "uv run --project ../.. python ../../scripts/export_workbench_openapi.py",
    "contracts:generate": "pnpm contracts:export && openapi-typescript --redocly redocly.yaml",
    "contracts:check": "uv run --project ../.. python ../../scripts/export_workbench_openapi.py --check && openapi-typescript --redocly redocly.yaml --check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.77.0",
    "react": "18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "18.3.1",
    "react-resizable-panels": "^4.24.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "1.9.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.7.3",
    "vite": "6.4.1"
  }
}
