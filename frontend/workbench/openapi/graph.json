              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "expected_revision",
          "edge",
          "longitude",
          "latitude"
        ],
        "title": "SourceSplitRequest",
        "type": "object"
      },
      "UpdatedEdgeAttributes": {
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "title": "Attributes",
            "type": "object"
          },
          "edge": {
            "$ref": "#/components/schemas/EdgeIdentity"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          }
        },
        "required": [
          "expected_revision",
          "edge",
          "attributes"
