{
  "components": {
    "schemas": {
      "DrawConnectionRequest": {
        "properties": {
          "aeroway": {
            "default": "taxiway",
            "title": "Aeroway",
            "type": "string"
          },
          "end": {
            "$ref": "#/components/schemas/NodeIdField"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "intermediate_points": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "maxItems": 10000,
            "title": "Intermediate Points",
            "type": "array"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "start": {
            "$ref": "#/components/schemas/NodeIdField"
          }
        },
        "required": [
          "expected_revision",
          "start",
          "end"
        ],
        "title": "DrawConnectionRequest",
        "type": "object"
      },
      "EdgeIdentity": {
        "additionalProperties": false,
        "description": "The stable identity of one MultiGraph edge.",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/EdgeKeyField"
          },
          "u": {
            "$ref": "#/components/schemas/NodeIdField"
          },
          "v": {
            "$ref": "#/components/schemas/NodeIdField"
          }
        },
        "required": [
          "u",
          "v",
          "key"
        ],
        "title": "EdgeIdentity",
        "type": "object"
      },
      "EdgeKeyField": {
        "minimum": 0.0,
        "type": "integer"
      },
      "EdgeRequest": {
        "properties": {
          "edge": {
            "$ref": "#/components/schemas/EdgeIdentity"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          }
        },
        "required": [
          "expected_revision",
          "edge"
        ],
        "title": "EdgeRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "context": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Context",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JsonValue": {},
      "ManualSnapRequest": {
        "properties": {
          "edge": {
            "$ref": "#/components/schemas/EdgeIdentity"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "node": {
            "$ref": "#/components/schemas/NodeIdField"
          }
        },
        "required": [
          "expected_revision",
          "node",
          "edge"
        ],
        "title": "ManualSnapRequest",
        "type": "object"
      },
      "MergeNodesRequest": {
        "properties": {
          "canonical_node_id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NodeIdField"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "node_ids": {
            "items": {
              "$ref": "#/components/schemas/NodeIdField"
            },
            "title": "Node Ids",
            "type": "array"
          }
        },
        "required": [
          "expected_revision"
        ],
        "title": "MergeNodesRequest",
        "type": "object"
      },
      "NodeDeletionRequest": {
        "properties": {
          "discard_unpaired": {
            "default": false,
            "title": "Discard Unpaired",
            "type": "boolean"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "node": {
            "$ref": "#/components/schemas/NodeIdField"
          },
          "pair_ids": {
            "items": {
              "type": "string"
            },
            "title": "Pair Ids",
            "type": "array"
          }
        },
        "required": [
          "expected_revision",
          "node"
        ],
        "title": "NodeDeletionRequest",
        "type": "object"
      },
      "NodeIdField": {
        "pattern": "^-?[1-9][0-9]*$",
        "type": "string"
      },
      "RestoreRequest": {
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "end": {
            "$ref": "#/components/schemas/NodeIdField"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "start": {
            "$ref": "#/components/schemas/NodeIdField"
          }
        },
        "required": [
          "expected_revision",
          "start",
          "end"
        ],
        "title": "RestoreRequest",
        "type": "object"
      },
      "SourceSplitRequest": {
        "properties": {
